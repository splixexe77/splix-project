# =============================================================
#  SPLIX unlock server — environment configuration
#  Copy this file to  server/.env  and fill in your values.
#  NEVER commit the real .env (it holds secrets) and NEVER put
#  these values into any frontend JS file.
# =============================================================

# ---------- Server ----------
# LOCAL defaults below.  On a hosting platform (e.g. Render) you normally
# leave HOST/PUBLIC_URL to the dashboard instead:
#   * the platform-provided PORT is used automatically,
#   * when HOST is unset the server binds 0.0.0.0 (platform/proxy mode),
#   * PUBLIC_URL falls back to the platform's external URL
#     (e.g. Render's RENDER_EXTERNAL_URL) until you set it explicitly.
PORT=8099
HOST=127.0.0.1

# Public origin of this server (no trailing slash).
# MUST match the URL people actually browse, because it is the
# OAuth redirect origin:  PUBLIC_URL + /api/oauth/callback
# Production:  PUBLIC_URL=https://your-domain.example   (https, no trailing /)
PUBLIC_URL=http://127.0.0.1:8099

# ---------- Storage ----------
# Folder holding links.json / reviews.json / settings.json /
# sessions.json / events.jsonl  (default: server/data).
# Production with a persistent disk, e.g. Render:  DATA_DIR=/var/data
#DATA_DIR=
# Optional first-boot seed folder: its data files are copied into an
# EMPTY data folder once at startup (existing files are never
# overwritten).  Create one with:  python server/migrate_data.py pack --out deploy-seed
#SEED_DIR=

# ---------- Admin panel ----------
# Long random string required to use /unlock-admin.html and the admin API.
# Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------- Official YouTube verification (Google OAuth + YouTube Data API) ----------
# Create these in Google Cloud Console → APIs & Services → Credentials
# (see server/README.md for the full step-by-step guide).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your channel ID (starts with UC…). Can also be set in the admin panel
# under "Site & footer". Env var wins when both are present.
YOUTUBE_CHANNEL_ID=

# ---------- Discord publishing (optional, webhook only — no bot token) ----------
DISCORD_WEBHOOK_URL=

# ---------- Optional tuning ----------
# How long a verified unlock stays valid (minutes)
SESSION_TTL_MIN=60
# How long a manual review request stays valid (minutes)
REVIEW_TTL_MIN=30
# OAuth state lifetime (seconds, single-use)
OAUTH_STATE_TTL_SEC=600
# Set to true only when running behind a reverse proxy you control
# (REQUIRED on Render/behind any HTTPS edge proxy: it enables real
# per-visitor rate limiting via X-Forwarded-For — rightmost entry —
# and Secure cookies via X-Forwarded-Proto).
TRUST_PROXY=false

# ---------- Rate limits (requests per window, in seconds) ----------
RL_API=180
RL_STATUS=120
RL_OAUTH=8
RL_REVIEW=5
RL_LIKE=30
RL_CLAIM=30
RL_ADMIN=180

# ---------- Test-only overrides (leave unset in production) ----------
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# YOUTUBE_API_BASE=https://www.googleapis.com
